# ===== App Garçom (garcom.gutty.app.br) =====
# Copie para .env.local e preencha. Valores devem casar com o app `caixa`.

# Banco master (clientes_web) — MESMO do caixa
MASTER_DATABASE_URL=postgresql://user:pass@host:port/dbname

# Chave AES (hex 64 chars) que decripta clientes_web.db_url_enc — MESMA do caixa
TENANT_ENCRYPTION_KEY=

# Segredo do JWT de empresa — MESMO do caixa (login de empresa compartilhado)
AUTH_JWT_SECRET=

# Segredo do JWT do vendedor/garçom (pode reutilizar AUTH_JWT_SECRET)
GARCOM_JWT_SECRET=

# SSL do Postgres (bancos cloudclusters usam self-signed)
DB_SSL_MODE=no-verify

# Cookies seguros (true quando garcom.gutty.app.br tiver HTTPS via nginx)
FORCE_SECURE_COOKIE=false

# Porta (PM2 também define)
PORT=3002
