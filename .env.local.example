# ===== App Garçom (garcom.gutty.app.br) =====
# Copie para .env.local e preencha. Valores devem casar com o app `caixa`.

# Banco master (clientes_web) — MESMO do caixa
MASTER_DATABASE_URL=postgresql://user:pass@host:port/dbname

# Chave AES (hex 64 chars) que decripta clientes_web.db_url_enc — MESMA do caixa
TENANT_ENCRYPTION_KEY=

# Segredo do JWT de empresa — MESMO do caixa (login de empresa compartilhado)
AUTH_JWT_SECRET=

# Segredo do JWT do vendedor/garçom (pode reutilizar AUTH_JWT_SECRET)
GARCOM_JWT_SECRET=

# SSL do Postgres (bancos cloudclusters usam self-signed)
DB_SSL_MODE=no-verify

# Cookies seguros (true quando garcom.gutty.app.br tiver HTTPS via nginx)
FORCE_SECURE_COOKIE=false

# Porta (PM2 também define)
PORT=3002

# ===== Modo "delivery com balcão" (opcional) =====
# Sem estas duas, o app roda só no modo tradicional (/garcom) e /balcao responde
# 503 retaguarda_nao_configurada.

# URL pública da retaguarda (sem barra no fim). É ela que tem o cardápio, as
# mesas, as comandas e o Kanban do balcão.
RETAGUARDA_URL=https://retaguarda.gutty.app.br

# Segredo compartilhado que assina o Bearer enviado pra retaguarda.
# Use o MESMO valor do AUTH_OP_SECRET da retaguarda; se ela não tiver
# AUTH_OP_SECRET definido, use o AUTH_JWT_SECRET dela.
# (Deixando em branco, cai no AUTH_JWT_SECRET daqui — só funciona se os dois
# lados compartilharem esse segredo.)
RETAGUARDA_GARCOM_SECRET=
